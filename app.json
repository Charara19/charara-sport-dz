{
  "expo": {
    "name": "شرارة سبورت DZ",
    "slug": "charara-sport-dz",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#070B09"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.charara.sportdz"
    },
    "package": "com.charara.sportdz",
    "android": {
      "package": "com.charara.sportdz",
      "permissions": [
        "android.permission.INTERNET"
      ],
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#070B09"
      },
      "edgeToEdgeEnabled": true,
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-video",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#00E676",
          "defaultChannel": "match-alerts"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "f9afd787-415a-4e87-a5a0-6b69368b741f"
      }
    },
    "owner": "charara.dz18"
  }
}
